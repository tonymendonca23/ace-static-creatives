---
import { home } from '../config/site';

export interface Props {
  items?: string[];
}

const { items = home.marquee } = Astro.props;
---

<div class="relative overflow-hidden border-y border-cream-dim/10 bg-surface py-5">
  <div
    class="pointer-events-none absolute inset-y-0 left-0 z-10 w-16 bg-gradient-to-r from-surface to-transparent sm:w-28"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute inset-y-0 right-0 z-10 w-16 bg-gradient-to-l from-surface to-transparent sm:w-28"
    aria-hidden="true"
  >
  </div>
  <div class="animate-marquee flex w-max items-center gap-12 whitespace-nowrap">
    {
      [...items, ...items, ...items, ...items].map((text) => (
        <span class="flex items-center gap-12">
          <span class="text-sm font-black uppercase tracking-[0.2em] text-sand/80">
            {text}
          </span>
          <span class="h-1.5 w-1.5 rounded-full bg-clay" aria-hidden="true" />
        </span>
      ))
    }
  </div>
</div>
