---
import { home } from '../config/site';

export interface Props {
  items?: string[];
}

const { items = home.marquee } = Astro.props;
---

<div class="relative overflow-hidden border-y border-cream/10 bg-surface py-5">
  <div class="animate-marquee flex w-max items-center gap-12 whitespace-nowrap">
    {
      [...items, ...items, ...items, ...items].map((text) => (
        <span class="flex items-center gap-12">
          <span class="text-sm font-bold uppercase tracking-[0.2em] text-gold/80">
            {text}
          </span>
          <span class="h-1.5 w-1.5 rounded-full bg-gold/60" aria-hidden="true" />
        </span>
      ))
    }
  </div>
</div>
