---
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/services', label: 'Services' },
  { href: '/portfolio', label: 'Portfolio' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === currentPath || (href !== '/' && currentPath.startsWith(href));
---

<header class="sticky top-0 z-50 w-full border-b border-cream-dim/10 bg-base/90 backdrop-blur-md">
  <div class="mx-auto max-w-7xl px-6">
    <nav class="flex h-16 items-center justify-between" aria-label="Primary">
      <a href="/" class="flex items-center gap-2 text-lg font-black tracking-tight text-cream">
        <span
          class="flex h-8 w-8 items-center justify-center rounded-md border border-sand/30 bg-surface-2 text-sm font-black text-sand"
          >A</span
        >
        Ace Static Creatives
      </a>

      <!-- Desktop nav -->
      <div class="hidden items-center gap-8 md:flex">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class:list={[
                'relative text-sm font-semibold transition-colors',
                isActive(link.href)
                  ? 'text-sand'
                  : 'text-cream/70 hover:text-cream',
              ]}
            >
              {link.label}
              {isActive(link.href) && (
                <span class="absolute -bottom-1 left-0 h-px w-full bg-sand" />
              )}
            </a>
          ))
        }
        <a
          href="https://wa.me/5926751884"
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-full bg-forest px-5 py-2.5 text-sm font-bold text-cream transition hover:-translate-y-0.5 hover:bg-forest/90"
        >
          Build My Digital Salesman
        </a>
      </div>

      <!-- Mobile menu -->
      <details class="group md:hidden">
        <summary
          class="cursor-pointer list-none text-cream transition hover:text-sand"
          aria-label="Toggle menu"
        >
          <svg
            class="h-7 w-7"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </summary>
        <div
          class="absolute left-0 right-0 top-16 border-b border-cream-dim/10 bg-base px-6 py-5 shadow-2xl"
        >
          <div class="flex flex-col gap-4">
            {
              navLinks.map((link) => (
                <a
                  href={link.href}
                  class:list={[
                    'text-base font-semibold transition-colors',
                    isActive(link.href)
                      ? 'text-sand'
                      : 'text-cream/90 hover:text-cream',
                  ]}
                >
                  {link.label}
                </a>
              ))
            }
            <a
              href="https://wa.me/5926751884"
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-full bg-forest px-5 py-3 text-center text-sm font-bold text-cream"
            >
              Build My Digital Salesman
            </a>
          </div>
        </div>
      </details>
    </nav>
  </div>
</header>

<style is:global>
  header summary::-webkit-details-marker {
    display: none;
  }
  header summary {
    list-style: none;
  }
</style>
