---
import { brand, nav } from '../config/site';

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === currentPath || (href !== '/' && currentPath.startsWith(href));
---

<header class="sticky top-0 z-50 w-full border-b border-cream/10 bg-base/85 backdrop-blur-sm">
  <div class="mx-auto max-w-7xl px-5 sm:px-6">
    <nav class="flex h-[4.25rem] items-center justify-between gap-4" aria-label="Primary">
      <a
        href="/"
        class="group flex shrink-0 items-center gap-2.5"
      >
        <img
          src="/asc-monogram.png"
          alt=""
          aria-hidden="true"
          width="129"
          height="128"
          class="h-8 w-auto transition-transform duration-300 group-hover:scale-105"
        />
        <span class="text-base font-bold tracking-tight text-cream sm:text-lg">Ace Static Creatives</span>
      </a>

      <!-- Desktop nav -->
      <div class="hidden items-center gap-1 md:flex">
        {
          nav.links.map((link) => (
            <a
              href={link.href}
              aria-current={isActive(link.href) ? 'page' : undefined}
              class:list={[
                'relative rounded-full px-4 py-2 text-sm font-semibold transition-colors duration-200',
                isActive(link.href)
                  ? 'bg-cream/10 text-gold'
                  : 'text-cream/70 hover:bg-surface hover:text-cream',
              ]}
            >
              {link.label}
            </a>
          ))
        }
        <a
          href={nav.cta.href}
          target="_blank"
          rel="noopener noreferrer"
          class="ml-3 inline-flex items-center gap-2 rounded-full bg-gold px-5 py-2.5 text-sm font-bold text-surface  transition-all duration-300 hover:-translate-y-0.5 hover:brightness-110"
        >
          {nav.cta.label}
          <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
      </div>

      <!-- Mobile menu -->
      <details class="group relative md:hidden">
        <summary
          class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-lg border border-cream/10 bg-surface text-cream transition hover:border-gold/40 hover:text-gold"
          aria-label="Toggle menu"
        >
          <svg
            class="h-5 w-5 group-open:hidden"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg
            class="hidden h-5 w-5 group-open:block"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </summary>
        <div
          class="fixed left-0 right-0 top-[4.25rem] border-b border-cream/10 bg-base/95 px-6 py-6 shadow-md backdrop-blur-sm"
        >
          <div class="flex flex-col gap-1">
            {
              nav.links.map((link) => (
                <a
                  href={link.href}
                  aria-current={isActive(link.href) ? 'page' : undefined}
                  class:list={[
                    'rounded-xl px-4 py-3 text-base font-semibold transition-colors',
                    isActive(link.href)
                      ? 'bg-cream/10 text-gold'
                      : 'text-cream/90 hover:bg-surface hover:text-cream',
                  ]}
                >
                  {link.label}
                </a>
              ))
            }
            <a
              href={nav.cta.href}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-3 rounded-full bg-gold px-5 py-3.5 text-center text-sm font-bold text-surface  transition hover:brightness-110"
            >
              {nav.cta.label}
            </a>
          </div>
        </div>
      </details>
    </nav>
  </div>
</header>

<style is:global>
  header summary::-webkit-details-marker {
    display: none;
  }
  header summary {
    list-style: none;
  }
</style>
