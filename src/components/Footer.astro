---
const explore = [
  { href: '/', label: 'Home' },
  { href: '/services', label: 'Services' },
  { href: '/portfolio', label: 'Portfolio' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
---

<footer class="border-t border-cream-dim/10 bg-surface">
  <div class="mx-auto max-w-7xl px-6 py-16">
    <div class="grid gap-12 md:grid-cols-12">
      <div class="md:col-span-5">
        <a href="/" class="flex items-center gap-2 text-lg font-black tracking-tight text-cream">
          <span
            class="flex h-8 w-8 items-center justify-center rounded-md border border-sand/30 bg-surface-2 text-sm font-black text-sand"
            >A</span
          >
          Ace Static Creatives
        </a>
        <p class="mt-4 max-w-sm leading-relaxed text-cream-dim/70">
          High-performance static websites, scroll-stopping ads, and persuasive copy built
          exclusively for Guyanese small businesses.
        </p>
      </div>

      <div class="md:col-span-3 md:col-start-7">
        <h4 class="mb-4 text-sm font-bold uppercase tracking-wider text-cream">Explore</h4>
        <ul class="space-y-2">
          {
            explore.map((link) => (
              <li>
                <a href={link.href} class="text-cream-dim/70 transition hover:text-sand">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="md:col-span-3">
        <h4 class="mb-4 text-sm font-bold uppercase tracking-wider text-cream">Contact</h4>
        <ul class="space-y-2">
          <li>
            <a
              href="https://wa.me/5926751884"
              target="_blank"
              rel="noopener noreferrer"
              class="text-cream-dim/70 transition hover:text-sand"
            >
              WhatsApp
            </a>
          </li>
          <li>
            <a
              href="mailto:hello@acestaticcreatives.com"
              class="text-cream-dim/70 transition hover:text-sand"
            >
              hello@acestaticcreatives.com
            </a>
          </li>
          <li>
            <span class="text-cream-dim/70">Georgetown, Guyana</span>
          </li>
        </ul>
      </div>
    </div>

    <div
      class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-cream-dim/10 pt-8 text-sm text-cream-dim/50 md:flex-row"
    >
      <p>&copy; {new Date().getFullYear()} Ace Static Creatives. All rights reserved.</p>
      <p>Built for speed on Georgetown mobile networks.</p>
    </div>
  </div>
</footer>
