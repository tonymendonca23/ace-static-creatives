---
import { brand, contact, footer, nav } from '../config/site';
---

<footer class="relative border-t border-cream-dim/10 bg-surface">
  <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-sand/40 to-transparent" aria-hidden="true"></div>
  <div class="mx-auto max-w-7xl px-6 py-16 lg:py-20">
    <div class="grid gap-12 md:grid-cols-12">
      <div class="md:col-span-5">
        <a href="/" class="flex items-center gap-2.5 text-lg font-black tracking-tight text-cream">
          <span
            class="flex h-9 w-9 items-center justify-center rounded-xl border border-sand/40 bg-gradient-to-br from-surface-2 to-base text-sm font-black text-sand"
            >{brand.logoInitial}</span
          >
          {brand.name}
        </a>
        <p class="mt-5 max-w-sm leading-relaxed text-cream-dim/70">
          {footer.blurb}
        </p>
        <a
          href={contact.whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 inline-flex items-center gap-2 rounded-full border border-forest/50 bg-forest/10 px-5 py-2.5 text-sm font-bold text-sand transition hover:border-forest hover:bg-forest/20"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"></path>
          </svg>
          WhatsApp us
        </a>
      </div>

      <div class="md:col-span-3 md:col-start-7">
        <h4 class="mb-5 text-sm font-bold uppercase tracking-wider text-cream">{footer.exploreHeading}</h4>
        <ul class="space-y-3">
          {
            nav.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="inline-flex items-center gap-2 text-cream-dim/70 transition hover:translate-x-0.5 hover:text-sand"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="md:col-span-3">
        <h4 class="mb-5 text-sm font-bold uppercase tracking-wider text-cream">{footer.contactHeading}</h4>
        <ul class="space-y-3">
          <li>
            <a
              href={contact.whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-cream-dim/70 transition hover:text-sand"
            >
              WhatsApp
            </a>
          </li>
          <li>
            <a
              href={`mailto:${contact.email}`}
              class="break-all text-cream-dim/70 transition hover:text-sand"
            >
              {contact.email}
            </a>
          </li>
          <li>
            <span class="text-cream-dim/70">{contact.location}</span>
          </li>
        </ul>
      </div>
    </div>

    <div
      class="mt-14 flex flex-col items-center justify-between gap-4 border-t border-cream-dim/10 pt-8 text-sm text-cream-dim/50 md:flex-row"
    >
      <p>&copy; {new Date().getFullYear()} {footer.copyrightName}. {footer.rightsText}</p>
      <p>{brand.footerTagline}</p>
    </div>
  </div>
</footer>
