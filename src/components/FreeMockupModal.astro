---
/**
 * FreeMockupModal.astro
 * A 4-step qualifying questionnaire modal that redirects the user to WhatsApp
 * with a pre-formatted message containing their answers.
 */

export interface Props {
  /** Phone number in international format without the leading + */
  phone?: string;
  /** Text shown on the modal trigger button */
  triggerLabel?: string;
  /** Optional extra classes for the trigger button */
  triggerClass?: string;
}

const {
  phone = '5926751884',
  triggerLabel = 'Claim Your Free Mockup',
  triggerClass = '',
} = Astro.props;

const industries = [
  'Local Service',
  'Beauty, Health & Spa',
  'Professional Services',
  'E-Commerce / Retail',
  'Other',
];

const statuses = [
  'No website yet',
  'Have a site but 0 leads',
  'Need an update/overhaul',
];

const goals = [
  'Get pre-qualified leads via WhatsApp',
  'Automate sales & brand',
  'Scale paid ads',
];
---

<!-- Trigger button -->
<button
  type="button"
  data-mockup-trigger
  class:list={[
    'inline-flex items-center justify-center gap-2 rounded-full bg-forest px-8 py-4 font-bold text-cream transition-all duration-300 hover:-translate-y-1 hover:bg-forest/90',
    triggerClass,
  ]}
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="currentColor"
    class="h-5 w-5 shrink-0"
    aria-hidden="true"
  >
    <path
      d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
    ></path>
  </svg>
  <span>{triggerLabel}</span>
</button>

<!-- Modal overlay -->
<div
  data-mockup-modal
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 px-4 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
  aria-labelledby="mockup-modal-title"
>
  <div
    class="relative w-full max-w-lg overflow-hidden rounded-2xl border border-cream-dim/10 bg-surface shadow-2xl"
  >
    <!-- Close button -->
    <button
      type="button"
      data-mockup-close
      class="absolute right-3 top-3 z-10 rounded-full bg-base/80 p-2 text-cream transition hover:bg-clay hover:text-cream"
      aria-label="Close modal"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-6 w-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2.5"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>

    <!-- Progress bar -->
    <div class="border-b border-cream-dim/10 bg-base px-6 py-4">
      <div class="flex items-center justify-between">
        <span data-mockup-step-label class="text-xs font-bold uppercase tracking-wider text-sand">
          Step 1 of 4
        </span>
        <span class="text-xs text-cream-dim/60">Free mockup</span>
      </div>
      <div class="mt-3 h-1.5 w-full rounded-full bg-surface-2">
        <div
          data-mockup-progress
          class="h-full rounded-full bg-forest transition-all duration-500"
          style="width: 25%"
        >
        </div>
      </div>
    </div>

    <!-- Form -->
    <form data-mockup-form class="px-6 py-8 md:px-8">
      <!-- Step 1: Industry -->
      <fieldset data-step="1" class="mockup-step space-y-5">
        <legend class="text-2xl font-black leading-tight text-cream" id="mockup-modal-title">
          What type of business are you operating?
        </legend>
        <div class="grid gap-3">
          {
            industries.map((option) => (
              <label class="group relative flex cursor-pointer items-center gap-3 rounded-xl border border-cream-dim/10 bg-base p-4 transition hover:border-sand/40 hover:bg-surface-2">
                <input
                  type="radio"
                  name="industry"
                  value={option}
                  required
                  class="h-5 w-5 shrink-0 cursor-pointer accent-forest"
                />
                <span class="font-medium text-cream-dim group-hover:text-cream">{option}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <!-- Step 2: Website Status -->
      <fieldset data-step="2" class="mockup-step hidden space-y-5">
        <legend class="text-2xl font-black leading-tight text-cream">
          What is the current state of your website?
        </legend>
        <div class="grid gap-3">
          {
            statuses.map((option) => (
              <label class="group relative flex cursor-pointer items-center gap-3 rounded-xl border border-cream-dim/10 bg-base p-4 transition hover:border-sand/40 hover:bg-surface-2">
                <input
                  type="radio"
                  name="status"
                  value={option}
                  required
                  class="h-5 w-5 shrink-0 cursor-pointer accent-forest"
                />
                <span class="font-medium text-cream-dim group-hover:text-cream">{option}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <!-- Step 3: Primary Goal -->
      <fieldset data-step="3" class="mockup-step hidden space-y-5">
        <legend class="text-2xl font-black leading-tight text-cream">
          What is your main focus for the next 30 days?
        </legend>
        <div class="grid gap-3">
          {
            goals.map((option) => (
              <label class="group relative flex cursor-pointer items-center gap-3 rounded-xl border border-cream-dim/10 bg-base p-4 transition hover:border-sand/40 hover:bg-surface-2">
                <input
                  type="radio"
                  name="goal"
                  value={option}
                  required
                  class="h-5 w-5 shrink-0 cursor-pointer accent-forest"
                />
                <span class="font-medium text-cream-dim group-hover:text-cream">{option}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <!-- Step 4: Contact Capture -->
      <fieldset data-step="4" class="mockup-step hidden space-y-5">
        <legend class="text-2xl font-black leading-tight text-cream">
          Where should we send your free mockup?
        </legend>
        <div class="space-y-4">
          <div>
            <label for="mockup-business" class="mb-2 block text-sm font-medium text-cream-dim">
              Business Name
            </label>
            <input
              type="text"
              id="mockup-business"
              name="businessName"
              required
              placeholder="e.g. Georgetown Auto Parts"
              class="w-full rounded-xl border border-cream-dim/10 bg-base px-4 py-3 text-cream placeholder:text-cream-dim/40 focus:border-forest focus:outline-none focus:ring-2 focus:ring-forest/20"
            />
          </div>
          <div>
            <label for="mockup-client" class="mb-2 block text-sm font-medium text-cream-dim">
              Your Name
            </label>
            <input
              type="text"
              id="mockup-client"
              name="clientName"
              required
              placeholder="e.g. Jane Doe"
              class="w-full rounded-xl border border-cream-dim/10 bg-base px-4 py-3 text-cream placeholder:text-cream-dim/40 focus:border-forest focus:outline-none focus:ring-2 focus:ring-forest/20"
            />
          </div>
        </div>
      </fieldset>

      <!-- Navigation -->
      <div class="mt-8 flex items-center justify-between gap-3">
        <button
          type="button"
          data-mockup-back
          class="hidden rounded-full border border-cream-dim/20 px-6 py-3 text-sm font-bold text-cream transition hover:border-sand hover:text-sand"
        >
          Back
        </button>
        <button
          type="button"
          data-mockup-next
          class="ml-auto rounded-full bg-forest px-8 py-3 text-sm font-bold text-cream transition hover:bg-forest/90 disabled:cursor-not-allowed disabled:opacity-50"
        >
          Next
        </button>
        <button
          type="submit"
          data-mockup-submit
          class="hidden w-full items-center justify-center gap-2 rounded-full bg-forest px-6 py-4 text-sm font-bold text-cream transition hover:bg-forest/90 sm:text-base"
        >
          <span>📲</span>
          <span>SUBMIT & CLAIM FREE MOCKUP VIA WHATSAPP</span>
        </button>
      </div>

      <p class="mt-4 text-center text-xs text-cream-dim/60">
        Takes 20 seconds. Zero obligation.
      </p>
    </form>
  </div>
</div>

<script define:vars={{ phone }}>
  /**
   * Multi-step modal logic.
   * - Validates the current step before advancing.
   * - Builds a pre-formatted WhatsApp message from the captured answers.
   * - Redirects the user to the wa.me deep link on submit.
   */
  (function () {
    const modal = document.querySelector('[data-mockup-modal]');
    const trigger = document.querySelector('[data-mockup-trigger]');
    const closeBtn = document.querySelector('[data-mockup-close]');
    const form = document.querySelector('[data-mockup-form]');
    const steps = Array.from(document.querySelectorAll('.mockup-step'));
    const nextBtn = document.querySelector('[data-mockup-next]');
    const backBtn = document.querySelector('[data-mockup-back]');
    const submitBtn = document.querySelector('[data-mockup-submit]');
    const progress = document.querySelector('[data-mockup-progress]');
    const stepLabel = document.querySelector('[data-mockup-step-label]');

    let currentStep = 1;
    const totalSteps = steps.length;

    function updateUI() {
      // Show/hide steps with a tiny fade-in effect
      steps.forEach((step) => {
        const stepNumber = Number(step.getAttribute('data-step'));
        if (stepNumber === currentStep) {
          step.classList.remove('hidden');
          step.classList.add('animate-fade-in');
          // Re-trigger animation
          void step.offsetWidth;
          step.style.opacity = '1';
        } else {
          step.classList.add('hidden');
          step.style.opacity = '0';
        }
      });

      // Progress bar & label
      const percent = (currentStep / totalSteps) * 100;
      progress.style.width = `${percent}%`;
      stepLabel.textContent = `Step ${currentStep} of ${totalSteps}`;

      // Buttons
      backBtn.classList.toggle('hidden', currentStep === 1);
      nextBtn.classList.toggle('hidden', currentStep === totalSteps);
      submitBtn.classList.toggle('hidden', currentStep !== totalSteps);
      submitBtn.classList.toggle('flex', currentStep === totalSteps);

      // Re-validate current step to enable/disable Next
      validateCurrentStep();
    }

    function validateCurrentStep() {
      if (currentStep === totalSteps) return;
      const activeStep = steps.find((s) => Number(s.getAttribute('data-step')) === currentStep);
      const required = activeStep.querySelectorAll('input[required]');

      // Group inputs by name so radio-button groups are validated correctly.
      // A group is "answered" if at least one option is checked.
      const names = new Set();
      required.forEach((input) => names.add(input.name));

      const allAnswered = Array.from(names).every((name) => {
        const inputs = activeStep.querySelectorAll(`input[name="${name}"]`);
        const isRadio = inputs.length > 0 && inputs[0].type === 'radio';
        if (isRadio) {
          return activeStep.querySelector(`input[name="${name}"]:checked`) !== null;
        }
        return Array.from(inputs).every((input) => input.value.trim() !== '');
      });

      nextBtn.disabled = !allAnswered;
    }

    function openModal() {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.style.overflow = 'hidden';
      updateUI();
    }

    function closeModal() {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.style.overflow = '';
    }

    function nextStep() {
      if (currentStep < totalSteps) {
        // Validate before moving forward
        if (nextBtn.disabled) return;
        currentStep++;
        updateUI();
      }
    }

    function prevStep() {
      if (currentStep > 1) {
        currentStep--;
        updateUI();
      }
    }

    function handleSubmit(event) {
      event.preventDefault();

      // Gather form data
      const formData = new FormData(form);
      const businessName = String(formData.get('businessName') || '').trim();
      const clientName = String(formData.get('clientName') || '').trim();
      const industry = String(formData.get('industry') || '');
      const status = String(formData.get('status') || '');
      const goal = String(formData.get('goal') || '');

      // Safety check: don't redirect if required fields are missing
      if (!businessName || !clientName || !industry || !status || !goal) {
        alert('Please complete all steps before submitting.');
        return;
      }

      // Compose the WhatsApp message
      const message =
        `Hi Ace Static Creatives! I just requested my free mockup on your site.\n\n` +
        `📌 Business Name: ${businessName}\n` +
        `👤 Name: ${clientName}\n` +
        `🏢 Industry: ${industry}\n` +
        `🌐 Current Site Status: ${status}\n` +
        `🎯 Primary Goal: ${goal}\n` +
        `💰 Mockup Value: $99,999 GYD\n\n` +
        `Looking forward to seeing the preview!`;

      // Build the secure wa.me deep link
      const whatsappUrl = `https://wa.me/${phone}?text=${encodeURIComponent(message)}`;

      // Redirect the browser to WhatsApp
      window.location.href = whatsappUrl;
    }

    // Event listeners
    trigger.addEventListener('click', openModal);
    closeBtn.addEventListener('click', closeModal);
    nextBtn.addEventListener('click', nextStep);
    backBtn.addEventListener('click', prevStep);
    form.addEventListener('submit', handleSubmit);
    form.addEventListener('change', validateCurrentStep);

    // Close on overlay click or Escape key
    modal.addEventListener('click', (event) => {
      if (event.target === modal) closeModal();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && modal.classList.contains('flex')) {
        closeModal();
      }
    });

    // Initial UI state
    updateUI();
  })();
</script>

<style>
  /* Smooth fade-in for step transitions */
  .mockup-step {
    transition: opacity 250ms ease-in-out;
  }
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .animate-fade-in {
    animation: fadeIn 250ms ease-out forwards;
  }
</style>
