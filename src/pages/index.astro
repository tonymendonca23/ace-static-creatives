---
import Layout from '../layouts/Layout.astro';
import WhatsAppCta from '../components/WhatsAppCta.astro';
import FreeMockupModal from '../components/FreeMockupModal.astro';
import Marquee from '../components/Marquee.astro';

const painPoints = [
  'They take forever to reply',
  'Surprise hourly bills',
  'Broken plugins after updates',
  'Sites that spin on mobile data',
];
---

<Layout>
  <main class="w-full overflow-hidden">
    <!-- HERO: outcome + proof image -->
    <section class="relative px-6 pt-10 lg:pt-14">
      <div class="mx-auto grid max-w-7xl items-center gap-12 pb-20 pt-8 lg:grid-cols-2 lg:pb-28 lg:pt-10">
        <div class="order-2 lg:order-1">
          <span class="inline-block rounded-full border border-sand/30 bg-surface-2 px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-sand">
            Guyana's Static Site Agency
          </span>
          <h1 class="mt-6 text-balance text-4xl font-black leading-[1.1] tracking-tight text-cream md:text-5xl lg:text-6xl">
            Give your small business an enterprise-grade,
            <span class="rounded-lg bg-forest/20 px-2 py-1 text-sand">24/7 digital salesman</span>-within 4 days.
          </h1>
          <p class="mt-6 max-w-lg text-lg leading-relaxed text-cream-dim">
            Without bankrupting your cash flow on arrogant corporate agencies. Just a fast,
            bulletproof storefront and a team that answers on WhatsApp.
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-4">
            <FreeMockupModal triggerLabel="Claim Your FREE 24/7 Digital Salesman Mockup" />
            <a
              href="/services"
              class="rounded-full border border-cream-dim/30 px-6 py-3.5 text-sm font-bold text-cream transition hover:border-sand hover:text-sand"
            >
              See how it works
            </a>
          </div>
          <p class="mt-5 text-sm text-cream-dim/50">
            No tech skills needed. No hidden hosting fees. No surprise bills.
          </p>
        </div>

        <div class="order-1 lg:order-2">
          <div class="relative">
            <div class="absolute -inset-4 rounded-3xl bg-gradient-to-br from-sand/10 to-clay/10 blur-2xl"></div>
            <img
              src="/hero-image-4.png"
              alt="Side-by-side comparison: a broken, slow website versus a fast, reliable static storefront"
              class="relative z-10 w-full rounded-2xl border border-cream-dim/10 shadow-2xl"
              width="1536"
              height="1024"
              loading="eager"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </section>

    <Marquee items={['Static DIGITAL SALESMAN', 'Scroll-Stopping Ads', 'Persuasive Copy', 'WhatsApp Support']} />

    <!-- PAIN: ugly truth -->
    <section class="px-6 py-24">
      <div class="mx-auto max-w-5xl">
        <div class="grid gap-12 lg:grid-cols-2 lg:items-start">
          <div>
            <h2 class="text-3xl font-black leading-tight text-cream md:text-5xl">
              The <span class="relative inline-block">
                ugly truth
                <svg class="absolute -bottom-1 left-0 w-full text-clay" viewBox="0 0 120 9" fill="none" preserveAspectRatio="none" aria-hidden="true">
                  <path d="M2.00025 6.99997C18.7509 9.37497 62.975 -3.20003 117.825 2.34997" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
                </svg>
              </span> about local web developers in Guyana
            </h2>
          </div>
          <div class="space-y-6 text-lg leading-relaxed text-cream-dim/80">
            <p>
              Most tech guys and corporate agencies follow a lazy, profitable cycle: <span class="text-cream font-semibold">they build once, collect your cash, and abandon you completely.</span>
            </p>
            <p>
              You message them on WhatsApp to change a price or fix a broken link. You get single
              ticks, ignored messages, or a surprise hourly bill just to reply.
            </p>
            <p>
              Meanwhile your business looks neglected, your links spin on weak mobile networks, and
              you waste hours repeating <span class="italic text-cream">"check PM for price"  </span>
              in chaotic Facebook comments.
            </p>
          </div>
        </div>

        <div class="mt-16 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {
            painPoints.map((point) => (
              <div class="rounded-xl border border-cream-dim/10 bg-surface px-5 py-4 text-sm font-semibold text-cream-dim">
                <span class="mr-2 text-clay">✕</span>
                {point}
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- TRANSFORMATION -->
    <section class="bg-surface px-6 py-24">
      <div class="mx-auto max-w-5xl">
        <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
          <div class="rounded-2xl border border-cream-dim/10 bg-base p-8 lg:p-12">
            <h2 class="text-3xl font-black leading-tight text-cream md:text-4xl">
              We killed the "build & abandon" model.
            </h2>
            <div class="mt-6 space-y-5 text-lg leading-relaxed text-cream-dim/80">
              <p>
                At Ace Static Creatives, we don't believe in charging you hundreds of thousands
                upfront just to ghost you next month.
              </p>
              <p>
                We build lightning-fast static DIGITAL SALESMAN that physically cannot break, don't use
                slow plugins, and load instantly on any smartphone data network in Georgetown.
              </p>
              <p class="font-semibold text-cream">
                Best of all? We stay by your side as your permanent digital growth partners.
              </p>
            </div>
          </div>
          <div class="space-y-6">
            <div class="rounded-xl border border-cream-dim/10 bg-base p-6">
              <h3 class="text-lg font-bold text-sand">Zero moving parts</h3>
              <p class="mt-2 text-cream-dim/70">
                No databases, no plugins, no update buttons. Just files that load.
              </p>
            </div>
            <div class="rounded-xl border border-cream-dim/10 bg-base p-6">
              <h3 class="text-lg font-bold text-sand">Built for Georgetown data speeds</h3>
              <p class="mt-2 text-cream-dim/70">
                Compressed assets, minimal requests, and instant first paint on mobile.
              </p>
            </div>
            <div class="rounded-xl border border-cream-dim/10 bg-base p-6">
              <h3 class="text-lg font-bold text-sand">Updates over WhatsApp</h3>
              <p class="mt-2 text-cream-dim/70">
                Text us a price change, a new image, or a promo. We handle it fast.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- TRIPLE ENGINE -->
    <section class="px-6 py-24">
      <div class="mx-auto max-w-6xl">
        <div class="mx-auto max-w-3xl text-center">
          <h2 class="text-3xl font-black leading-tight text-cream md:text-5xl">
            <span class="relative inline-block">
              Everything
              <svg class="absolute -bottom-1 left-0 w-full text-forest/70" viewBox="0 0 140 9" fill="none" preserveAspectRatio="none" aria-hidden="true">
                <path d="M2.00025 6.99997C21.7509 9.37497 72.975 -3.20003 137.825 2.34997" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
              </svg>
            </span> you need to dominate the local market
          </h2>
          <p class="mt-5 text-lg text-cream-dim/80">
            We don't hand you a website and leave you to figure out marketing alone. We build your
            entire customer-acquisition engine.
          </p>
        </div>

        <div class="mt-16 grid gap-8 md:grid-cols-3">
          <article class="group rounded-2xl border border-cream-dim/10 bg-surface p-8 transition hover:border-sand/40">
            <div class="mb-6 flex h-12 w-12 items-center justify-center rounded-lg border border-sand/30 text-xl font-black text-sand">
              1
            </div>
            <h3 class="text-xl font-bold text-cream">High-performance static Digital Salesman</h3>
            <p class="mt-3 leading-relaxed text-cream-dim/70">
              Modern sites that convert casual visitors into paying leads.
            </p>
          </article>
          <article class="group rounded-2xl border border-cream-dim/10 bg-surface p-8 transition hover:border-sand/40">
            <div class="mb-6 flex h-12 w-12 items-center justify-center rounded-lg border border-sand/30 text-xl font-black text-sand">
              2
            </div>
            <h3 class="text-xl font-bold text-cream">High-stopping-power static ads</h3>
            <p class="mt-3 leading-relaxed text-cream-dim/70">
              Bold, engineered creatives that own the scroll on Facebook and Instagram feeds.
            </p>
          </article>
          <article class="group rounded-2xl border border-cream-dim/10 bg-surface p-8 transition hover:border-sand/40">
            <div class="mb-6 flex h-12 w-12 items-center justify-center rounded-lg border border-sand/30 text-xl font-black text-sand">
              3
            </div>
            <h3 class="text-xl font-bold text-cream">Digital persuasion ads</h3>
            <p class="mt-3 leading-relaxed text-cream-dim/70">
              Psychological copy that taps local desires, dismantles doubts, and drives WhatsApp
              inquiries.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- 3-STEP PROCESS -->
    <section class="bg-surface px-6 py-24">
      <div class="mx-auto max-w-4xl">
        <h2 class="text-center text-3xl font-black leading-tight text-cream md:text-5xl">
          Your <span class="rounded-lg bg-forest/20 px-2 py-0.5 text-sand">digital salesman</span> live in <span class="text-sand">3 simple steps</span>
        </h2>

        <div class="mt-14 grid gap-8 md:grid-cols-3">
          <div class="relative rounded-2xl border border-cream-dim/10 bg-base p-8">
            <span class="absolute -top-4 left-6 rounded-full bg-forest px-3 py-1 text-xs font-bold text-cream">
              Step 1
            </span>
            <h3 class="mt-2 text-xl font-bold text-cream">The WhatsApp briefing</h3>
            <p class="mt-3 text-cream-dim/70">
              We look at your social pages, layout your goals, and outline your offer.
            </p>
          </div>
          <div class="relative rounded-2xl border border-cream-dim/10 bg-base p-8">
            <span class="absolute -top-4 left-6 rounded-full bg-forest px-3 py-1 text-xs font-bold text-cream">
              Step 2
            </span>
            <h3 class="mt-2 text-xl font-bold text-cream">Review your free mockup</h3>
            <p class="mt-3 text-cream-dim/70">
              Within 4 days, you get an elite digital salesman layout built for your brand.
            </p>
          </div>
          <div class="relative rounded-2xl border border-cream-dim/10 bg-base p-8">
            <span class="absolute -top-4 left-6 rounded-full bg-forest px-3 py-1 text-xs font-bold text-cream">
              Step 3
            </span>
            <h3 class="mt-2 text-xl font-bold text-cream">Launch & scale</h3>
            <p class="mt-3 text-cream-dim/70">
              We deploy, design your ads, and manage the tech monthly while you run your business.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="px-6 py-24">
      <div class="mx-auto max-w-3xl">
        <h2 class="text-center text-3xl font-black leading-tight text-cream md:text-4xl">
          Frequently asked questions
        </h2>

        <div class="mt-12 space-y-4">
          <details class="group rounded-xl border border-cream-dim/10 bg-surface open:border-sand/40">
            <summary class="flex cursor-pointer list-none items-center justify-between p-6 font-bold text-cream transition hover:text-sand">
              <span>Do I need to know how to code or manage web hosting?</span>
              <svg
                class="h-5 w-5 text-sand transition group-open:rotate-180"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <p class="px-6 pb-6 leading-relaxed text-cream-dim/80">
              Absolutely not. We handle all setup, hosting, and maintenance. You focus on running
              your business; we act as your dedicated digital mechanics.
            </p>
          </details>
          <details class="group rounded-xl border border-cream-dim/10 bg-surface open:border-sand/40">
            <summary class="flex cursor-pointer list-none items-center justify-between p-6 font-bold text-cream transition hover:text-sand">
              <span>How are static sites faster than normal websites?</span>
              <svg
                class="h-5 w-5 text-sand transition group-open:rotate-180"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <p class="px-6 pb-6 leading-relaxed text-cream-dim/80">
              Traditional sites rebuild themselves on every click. Static sites are pre-built, so
              the server hands the customer a ready-made page instantly. Zero processing time.
            </p>
          </details>
          <details class="group rounded-xl border border-cream-dim/10 bg-surface open:border-sand/40">
            <summary class="flex cursor-pointer list-none items-center justify-between p-6 font-bold text-cream transition hover:text-sand">
              <span>What if I want to change a price or layout later?</span>
              <svg
                class="h-5 w-5 text-sand transition group-open:rotate-180"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <p class="px-6 pb-6 leading-relaxed text-cream-dim/80">
              Just send us a WhatsApp message. As your permanent partners, we handle all updates,
              price changes, and layout tweaks.
            </p>
          </details>
        </div>
      </div>
    </section>

    <!-- FINAL CTA -->
    <section class="px-6 py-24">
      <div class="mx-auto max-w-4xl rounded-[2rem] border border-cream-dim/10 bg-gradient-to-br from-surface to-base p-8 text-center md:p-16">
        <h2 class="text-3xl font-black leading-tight text-cream md:text-5xl">
          Put an expert team in your contacts today
        </h2>
        <p class="mx-auto mt-5 max-w-2xl text-lg text-cream-dim/80">
          No tech jargon. No hidden hosting fees. No surprise bills. Just an affordable,
          small-business-friendly monthly partnership that keeps your online presence sharp.
        </p>
        <p class="mx-auto mt-5 max-w-xl rounded-xl border border-cream-dim/10 bg-base p-4 text-cream-dim">
          Need an update, image change, or new promo? Text it to us on WhatsApp and it's done.
        </p>
        <div class="mt-10">
          <FreeMockupModal triggerLabel="Claim Your FREE 24/7 Digital Salesman Mockup" />
        </div>
      </div>
    </section>
  </main>
</Layout>
