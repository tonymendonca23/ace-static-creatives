---
import Layout from '../layouts/Layout.astro';
import WhatsAppCta from '../components/WhatsAppCta.astro';
import Marquee from '../components/Marquee.astro';
import { home, contact } from '../config/site';

const { hero, positioning, servicesGrid, plans, updates, guarantee, process, faq, finalCta } = home;

const whatsappIntro = `Hi ${'Ace Static Creatives'}! I want to claim my Digital Salesman for my business in Guyana.`;
---

<Layout>
  <main class="w-full overflow-hidden">
    <!-- SECTION 1: HERO (The Hook) -->
    <section class="relative px-6 pt-12 lg:pt-16">
      <div class="relative mx-auto grid max-w-7xl items-center gap-12 pb-20 pt-6 lg:grid-cols-2 lg:gap-16 lg:pb-28">
        <div class="order-2 lg:order-1" data-reveal>
          <span class="inline-flex items-center gap-2 rounded-full border border-gold/40 bg-surface px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-gold">
            <span class="h-2 w-2 rounded-full bg-gold" aria-hidden="true"></span>
            {hero.badge}
          </span>
          <h1 class="mt-6 text-balance text-4xl font-bold leading-[1.05] tracking-tight text-cream md:text-5xl lg:text-6xl">
            {hero.headlineStart}
            <span class="relative mx-1 inline-block rounded-lg bg-gold/15 px-2 py-1 text-gold">
              {hero.headlineHighlight}
            </span>
          </h1>
          <p class="mt-6 max-w-lg text-lg leading-relaxed text-cream/90">
            {hero.subheadline}
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-4">
            <WhatsAppCta label={hero.primaryCta} message={whatsappIntro} />
            <a
              href={hero.secondaryCta.href}
              class="group inline-flex items-center gap-2 rounded-full border border-cream/40 px-6 py-3.5 text-sm font-bold text-cream transition hover:border-gold hover:text-gold"
            >
              {hero.secondaryCta.label}
              <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>
          <p class="mt-5 text-sm text-cream/60">
            {hero.reassurance}
          </p>

          <!-- Trust stats -->
          <dl class="mt-10 grid max-w-md grid-cols-3 gap-4 border-t border-cream/10 pt-8">
            {
              hero.stats.map((stat) => (
                <div>
                  <dt class="sr-only">{stat.label}</dt>
                  <dd class="text-2xl font-bold text-gold md:text-3xl">{stat.value}</dd>
                  <dd class="mt-1 text-xs leading-snug text-cream/70">{stat.label}</dd>
                </div>
              ))
            }
          </dl>
        </div>

        <div class="order-1 lg:order-2" data-reveal style="--reveal-delay: 120ms">
          <div class="relative">
            <picture>
              <source
                type="image/webp"
                srcset="/hero-400w.webp 400w, /hero-800w.webp 800w, /hero-1200w.webp 1200w, /hero-1536w.webp 1536w"
                sizes="(max-width: 768px) 100vw, 50vw"
              />
              <img
                src={hero.image.src}
                alt={hero.image.alt}
                class="relative z-10 w-full rounded-2xl border border-cream/15"
                width={hero.image.width}
                height={hero.image.height}
                loading="eager"
                decoding="async"
                fetchpriority="high"
              />
            </picture>
            <div class="absolute -bottom-4 -left-3 z-20 flex items-center gap-3 rounded-2xl border border-cream/15 bg-surface px-4 py-3 shadow-md lg:-left-6">
              <span class="flex h-9 w-9 items-center justify-center rounded-full bg-gold text-surface">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              </span>
              <div>
                <p class="text-sm font-bold text-cream">Loads instantly</p>
                <p class="text-xs text-cream/60">on any mobile network</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <Marquee items={home.marquee} />

    <!-- SECTION 2: PAIN vs SOLUTION (Positioning) -->
    <section class="relative bg-surface px-6 py-24 lg:py-32">
      <div class="relative mx-auto max-w-6xl">
        <div class="mx-auto max-w-3xl text-center" data-reveal>
          <h2 class="text-balance text-3xl font-bold leading-tight text-cream md:text-5xl">
            {positioning.heading}
          </h2>
          <p class="mt-5 text-lg text-cream/80">
            {positioning.subheading}
          </p>
        </div>

        <!-- Neglected vs thriving storefront: lands the contrast before the rows -->
        <div class="mx-auto mt-14 max-w-4xl" data-reveal>
          <img
            src="/img/positioning-split-1600w.webp"
            srcset="/img/positioning-split-800w.webp 800w, /img/positioning-split-1600w.webp 1600w"
            sizes="(min-width: 768px) 896px, 100vw"
            alt="Illustration comparing an abandoned crooked storefront on the left with an upright thriving storefront on the right, whose gold sign and clean pathway draw customers in"
            class="aspect-video w-full rounded-2xl border border-cream/15 object-cover"
            width="1600"
            height="900"
            loading="lazy"
            decoding="async"
          />
        </div>

        <div class="mt-16 space-y-6">
          {
            positioning.rows.map((row, i) => (
              <div
                class="card-elevated grid overflow-hidden rounded-2xl border border-cream/10 bg-base md:grid-cols-2"
                data-reveal
                style={`--reveal-delay: ${i * 90}ms`}
              >
                <div class="p-7 md:p-8">
                  <p class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-cream/60">
                    <span aria-hidden="true">✕</span> {row.pain}
                  </p>
                  <p class="mt-3 leading-relaxed text-cream/70">{row.painBody}</p>
                </div>
                <div class="relative border-t border-gold/25 bg-gold/10 p-7 md:border-l md:border-t-0 md:p-8">
                  <p class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-gold">
                    <span aria-hidden="true">✓</span> {row.solution}
                  </p>
                  <p class="mt-3 leading-relaxed text-cream">{row.solutionBody}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- SERVICES GRID: internal links to money pages with descriptive anchors -->
    <section class="relative px-6 py-24 lg:py-32">
      <div class="relative mx-auto max-w-6xl">
        <div class="mx-auto max-w-3xl text-center" data-reveal>
          <h2 class="text-balance text-3xl font-bold leading-tight text-cream md:text-5xl">
            {servicesGrid.heading}
          </h2>
          <p class="mt-5 text-lg text-cream/80">
            {servicesGrid.subheading}
          </p>
        </div>

        <div class="mt-16 grid gap-6 sm:grid-cols-2 lg:gap-8">
          {
            servicesGrid.items.map((item, i) => (
              <a
                href={item.href}
                class="card-elevated group relative overflow-hidden rounded-2xl border border-cream/10 bg-surface p-8 hover:border-gold/50"
                data-reveal
                style={`--reveal-delay: ${i * 100}ms`}
              >
                <h3 class="text-2xl font-semibold text-cream transition group-hover:text-gold">{item.title}</h3>
                <p class="mt-3 leading-relaxed text-cream/70">{item.blurb}</p>
                <p class="mt-5 inline-flex items-center gap-2 text-sm font-bold text-gold">
                  See {item.anchor}
                  <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                  </svg>
                </p>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- SECTION 3: THE OFFERS (Pricing Cards) -->
    <section class="relative bg-surface px-6 py-24 lg:py-32">
      <div class="relative mx-auto max-w-5xl">
        <div class="mb-16 text-center" data-reveal>
          <h2 class="text-balance text-3xl font-bold leading-tight text-cream md:text-5xl">
            {plans.heading}
          </h2>
          <p class="mx-auto mt-4 max-w-2xl text-lg text-cream/80">
            {plans.subheading}
          </p>
        </div>

        <div class="grid gap-8 md:grid-cols-2 md:items-stretch">
          {
            plans.items.map((pkg, i) => (
              <div
                class:list={[
                  'card-elevated relative flex flex-col rounded-2xl border p-8 pt-10',
                  pkg.featured
                    ? 'border-gold/70 bg-base '
                    : 'border-cream/10 bg-base',
                ]}
                data-reveal
                style={`--reveal-delay: ${i * 100}ms`}
              >
                <span
                  class:list={[
                    'absolute -top-3.5 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-full px-4 py-1.5 text-xs font-bold uppercase tracking-wider',
                    pkg.featured
                      ? 'bg-gold text-surface '
                      : 'bg-cream/10 text-cream',
                  ]}
                >
                  {pkg.tag}
                </span>

                <h3 class="text-3xl font-semibold text-cream">{pkg.name}</h3>

                <div class="mt-5 space-y-1.5 border-b border-cream/10 pb-6">
                  <p class="text-sm text-cream/70">{pkg.priceSetup}</p>
                  <p class="text-4xl font-bold text-gold md:text-5xl">{pkg.priceMonthly}</p>
                  <p class="text-xs text-cream/70">{pkg.term}</p>
                </div>

                <ul class="mt-6 flex-1 space-y-3.5">
                  {pkg.features.map((feature) => (
                    <li class="flex items-start gap-3 text-sm leading-relaxed text-cream">
                      <svg
                        class="mt-0.5 h-5 w-5 shrink-0 text-gold"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                      >
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                      </svg>
                      {feature}
                    </li>
                  ))}
                </ul>

                <div class="mt-8">
                  <WhatsAppCta label={pkg.cta} message={`Hi Ace Static Creatives! I'm interested in ${pkg.name} (${pkg.priceMonthly}). Can we talk?`} class="w-full" />
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- SECTION 4: WHAT COUNTS AS AN UPDATE (Transparency) -->
    <section class="px-6 py-24 lg:py-28">
      <div class="mx-auto max-w-5xl" data-reveal>
        <h2 class="text-center text-balance text-2xl font-bold leading-tight text-cream md:text-4xl">
          {updates.heading}
        </h2>
        <div class="mt-10 grid gap-6 md:grid-cols-2">
          <div class="rounded-2xl border border-gold/40 bg-surface p-8">
            <p class="text-sm font-bold uppercase tracking-wider text-gold">✓ Included in your plan</p>
            <ul class="mt-5 space-y-3">
              {updates.included.map((item) => (
                <li class="flex items-start gap-3 text-sm leading-relaxed text-cream">
                  <span class="mt-0.5 text-gold">✓</span>
                  {item}
                </li>
              ))}
            </ul>
            <p class="mt-5 text-xs italic text-cream/70">{updates.includedNote}</p>
          </div>
          <div class="rounded-2xl border border-cream/15 bg-surface p-8">
            <p class="text-sm font-bold uppercase tracking-wider text-cream/60">✕ Billed as project add-ons</p>
            <ul class="mt-5 space-y-3">
              {updates.notIncluded.map((item) => (
                <li class="flex items-start gap-3 text-sm leading-relaxed text-cream">
                  <span class="mt-0.5 text-cream/60">✕</span>
                  {item}
                </li>
              ))}
            </ul>
            <p class="mt-5 text-xs italic text-cream/70">{updates.notIncludedNote}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 5: THE 90-DAY GUARANTEE (Safe) -->
    <section class="px-6 pb-8">
      <div
        class="relative mx-auto max-w-4xl overflow-hidden rounded-2xl border border-gold/50 bg-surface p-8 text-center md:p-14"
        data-reveal
      >
        <img
          src="/img/guarantee-seal.webp"
          alt=""
          aria-hidden="true"
          class="mx-auto mb-6 h-24 w-24 md:h-28 md:w-28"
          width="512"
          height="512"
          loading="lazy"
          decoding="async"
        />
        <h2 class="text-balance text-2xl font-bold leading-tight text-cream md:text-4xl">
          {guarantee.heading}
        </h2>
        <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-cream/80">
          {guarantee.body}
        </p>
      </div>
    </section>

    <!-- HOW IT WORKS (flywheel: portfolio previews, no mockups) -->
    <section class="px-6 py-24 lg:py-32">
      <div class="mx-auto max-w-5xl">
        <h2 class="text-center text-balance text-3xl font-bold leading-tight text-cream md:text-5xl" data-reveal>
          {process.headingStart}
          <span class="rounded-lg bg-gold/15 px-2 py-0.5 text-gold">{process.headingHighlight}</span>
          {process.headingMiddle}
          <span class="text-gold">{process.headingAccent}</span>
        </h2>

        <div class="relative mt-16 grid gap-10 md:grid-cols-3 md:gap-8">
          <div class="pointer-events-none absolute left-[16%] right-[16%] top-0 hidden h-px bg-gold/30 md:block" aria-hidden="true"></div>
          {
            process.steps.map((step, i) => (
              <div
                class="card-elevated relative rounded-2xl border border-cream/10 bg-surface p-8 pt-10 hover:border-gold/60"
                data-reveal
                style={`--reveal-delay: ${i * 120}ms`}
              >
                <span class="absolute -top-4 left-6 rounded-full bg-gold px-4 py-1.5 text-xs font-bold uppercase tracking-wide text-surface ">
                  {step.tag}
                </span>
                <h3 class="text-2xl font-semibold text-cream">{step.title}</h3>
                <p class="mt-3 leading-relaxed text-cream/70">{step.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="bg-surface px-6 py-24 lg:py-32">
      <div class="mx-auto max-w-3xl">
        <h2 class="text-center text-balance text-3xl font-bold leading-tight text-cream md:text-4xl" data-reveal>
          {faq.heading}
        </h2>

        <div class="mt-12 space-y-4">
          {
            faq.items.map((item, i) => (
              <details
                class="group rounded-2xl border border-cream/10 bg-base transition-colors open:border-gold/40 open: hover:border-cream/25"
                data-reveal
                style={`--reveal-delay: ${i * 80}ms`}
              >
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-6 font-bold text-cream transition hover:text-gold">
                  <span>{item.question}</span>
                  <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-gold/30 bg-surface text-gold transition-transform duration-300 group-open:rotate-180">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                    </svg>
                  </span>
                </summary>
                <p class="px-6 pb-6 leading-relaxed text-cream/80">{item.answer}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- FINAL CTA -->
    <section class="px-6 pb-28 pt-24">
      <div
        class="relative mx-auto max-w-4xl overflow-hidden rounded-2xl border border-gold/25 bg-surface p-8 text-center md:p-16"
        data-reveal
      >
        <div class="relative">
          <h2 class="text-balance text-3xl font-bold leading-tight text-cream md:text-5xl">
            {finalCta.heading}
          </h2>
          <p class="mx-auto mt-5 max-w-2xl text-lg text-cream/80">
            {finalCta.body}
          </p>
          <p class="mx-auto mt-6 max-w-xl rounded-2xl border border-cream/10 bg-base/80 p-4 text-cream backdrop-blur-sm">
            {finalCta.note}
          </p>
          <div class="mt-10 flex justify-center">
            <WhatsAppCta label={finalCta.cta} message={whatsappIntro} />
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
