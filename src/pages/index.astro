---
import Layout from '../layouts/Layout.astro';
import FreeMockupModal from '../components/FreeMockupModal.astro';
import Marquee from '../components/Marquee.astro';
import { home } from '../config/site';

const { hero, pain, transformation, tripleEngine, process, faq, finalCta } = home;

const transformationIcons: Record<string, string> = {
  shield:
    'M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z',
  bolt: 'M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z',
  chat: 'M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 01-2.555-.337A5.972 5.972 0 015.41 20.97a5.969 5.969 0 01-.474-.065 4.48 4.48 0 00.978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z',
};
---

<Layout>
  <main class="w-full overflow-hidden">
    <!-- HERO: outcome + proof image -->
    <section class="relative px-6 pt-12 lg:pt-16">
      <div class="bg-glow-forest pointer-events-none absolute inset-0" aria-hidden="true"></div>
      <div class="relative mx-auto grid max-w-7xl items-center gap-12 pb-20 pt-6 lg:grid-cols-2 lg:gap-16 lg:pb-28">
        <div class="order-2 lg:order-1" data-reveal>
          <span class="inline-flex items-center gap-2 rounded-full border border-sand/30 bg-surface-2 px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-sand">
            <span class="relative flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-forest opacity-75"></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-forest"></span>
            </span>
            {hero.badge}
          </span>
          <h1 class="mt-6 text-balance text-4xl font-black leading-[1.08] tracking-tight text-cream md:text-5xl lg:text-6xl">
            {hero.headlineStart}
            <span class="relative mx-1 inline-block rounded-lg bg-forest/20 px-2 py-1 text-sand">
              {hero.headlineHighlight}
            </span>{hero.headlineEnd}
          </h1>
          <p class="mt-6 max-w-lg text-lg leading-relaxed text-cream-dim/90">
            {hero.subheadline}
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-4">
            <FreeMockupModal triggerLabel={hero.primaryCta} />
            <a
              href={hero.secondaryCta.href}
              class="group inline-flex items-center gap-2 rounded-full border border-cream-dim/30 px-6 py-3.5 text-sm font-bold text-cream transition hover:border-sand hover:text-sand"
            >
              {hero.secondaryCta.label}
              <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>
          <p class="mt-5 text-sm text-cream-dim/50">
            {hero.reassurance}
          </p>

          <!-- Trust stats -->
          <dl class="mt-10 grid max-w-md grid-cols-3 gap-4 border-t border-cream-dim/10 pt-8">
            {
              hero.stats.map((stat) => (
                <div>
                  <dt class="sr-only">{stat.label}</dt>
                  <dd class="text-2xl font-black text-sand md:text-3xl">{stat.value}</dd>
                  <dd class="mt-1 text-xs leading-snug text-cream-dim/60">{stat.label}</dd>
                </div>
              ))
            }
          </dl>
        </div>

        <div class="order-1 lg:order-2" data-reveal style="--reveal-delay: 120ms">
          <div class="relative">
            <div class="absolute -inset-6 rounded-[2.5rem] bg-gradient-to-br from-sand/15 via-forest/10 to-clay/15 blur-3xl" aria-hidden="true"></div>
            <div class="absolute -right-3 -top-3 h-24 w-24 rounded-2xl border border-sand/20 bg-dot-grid opacity-60 lg:-right-6 lg:-top-6 lg:h-32 lg:w-32" aria-hidden="true"></div>
            <img
              src={hero.image.src}
              alt={hero.image.alt}
              class="relative z-10 w-full rounded-2xl border border-cream-dim/15 shadow-[0_32px_64px_-16px_rgb(0_0_0_/_0.7)]"
              width={hero.image.width}
              height={hero.image.height}
              loading="eager"
              decoding="async"
            />
            <div class="absolute -bottom-4 -left-3 z-20 flex items-center gap-3 rounded-2xl border border-cream-dim/15 bg-surface/95 px-4 py-3 shadow-2xl backdrop-blur-md lg:-left-6">
              <span class="flex h-9 w-9 items-center justify-center rounded-full bg-forest/20 text-forest">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              </span>
              <div>
                <p class="text-sm font-bold text-cream">Loads instantly</p>
                <p class="text-xs text-cream-dim/60">on any mobile network</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <Marquee items={home.marquee} />

    <!-- PAIN: ugly truth -->
    <section class="relative px-6 py-24 lg:py-32">
      <div class="mx-auto max-w-5xl">
        <div class="grid gap-12 lg:grid-cols-2 lg:items-start" data-reveal>
          <div class="lg:sticky lg:top-28">
            <h2 class="text-3xl font-black leading-tight text-cream md:text-5xl">
              {pain.headingStart}
              <span class="relative inline-block">
                {pain.headingUnderlined}
                <svg class="absolute -bottom-1 left-0 w-full text-clay" viewBox="0 0 120 9" fill="none" preserveAspectRatio="none" aria-hidden="true">
                  <path d="M2.00025 6.99997C18.7509 9.37497 62.975 -3.20003 117.825 2.34997" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
                </svg>
              </span>
              {pain.headingEnd}
            </h2>
          </div>
          <div class="space-y-6 text-lg leading-relaxed text-cream-dim/80">
            {
              pain.paragraphs.map((p) => (
                <p>
                  {p.before}
                  {p.emphasis && <span class="font-semibold italic text-cream">{p.emphasis}</span>}
                  {p.after}
                </p>
              ))
            }
          </div>
        </div>

        <div class="mt-16 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {
            pain.points.map((point, i) => (
              <div
                class="card-elevated rounded-xl border border-clay/20 bg-surface px-5 py-4 text-sm font-semibold text-cream-dim hover:border-clay/50"
                data-reveal
                style={`--reveal-delay: ${i * 80}ms`}
              >
                <span class="mr-2 text-clay">✕</span>
                {point}
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- TRANSFORMATION -->
    <section class="relative bg-surface px-6 py-24 lg:py-32">
      <div class="bg-dot-grid pointer-events-none absolute inset-0 opacity-40" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-5xl">
        <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
          <div class="rounded-3xl border border-cream-dim/10 bg-base p-8 shadow-[0_24px_48px_-16px_rgb(0_0_0_/_0.5)] lg:p-12" data-reveal>
            <h2 class="text-3xl font-black leading-tight text-cream md:text-4xl">
              {transformation.heading}
            </h2>
            <div class="mt-6 space-y-5 text-lg leading-relaxed text-cream-dim/80">
              {transformation.paragraphs.map((p) => <p>{p}</p>)}
              <p class="font-semibold text-cream">{transformation.closer}</p>
            </div>
          </div>
          <div class="space-y-5">
            {
              transformation.cards.map((card, i) => (
                <div
                  class="card-elevated group flex gap-5 rounded-2xl border border-cream-dim/10 bg-base p-6 hover:border-sand/40"
                  data-reveal
                  style={`--reveal-delay: ${i * 100}ms`}
                >
                  <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-sand/30 bg-surface text-sand transition-colors group-hover:border-sand/60 group-hover:bg-forest/10">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d={transformationIcons[card.icon]} />
                    </svg>
                  </span>
                  <div>
                    <h3 class="text-lg font-bold text-sand">{card.title}</h3>
                    <p class="mt-2 text-cream-dim/70">{card.body}</p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- TRIPLE ENGINE -->
    <section class="relative px-6 py-24 lg:py-32">
      <div class="bg-glow-sand pointer-events-none absolute inset-0" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-6xl">
        <div class="mx-auto max-w-3xl text-center" data-reveal>
          <h2 class="text-3xl font-black leading-tight text-cream md:text-5xl">
            <span class="relative inline-block">
              {tripleEngine.headingUnderlined}
              <svg class="absolute -bottom-1 left-0 w-full text-forest/70" viewBox="0 0 140 9" fill="none" preserveAspectRatio="none" aria-hidden="true">
                <path d="M2.00025 6.99997C21.7509 9.37497 72.975 -3.20003 137.825 2.34997" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
              </svg>
            </span>
            {tripleEngine.headingEnd}
          </h2>
          <p class="mt-5 text-lg text-cream-dim/80">
            {tripleEngine.subheading}
          </p>
        </div>

        <div class="mt-16 grid gap-6 md:grid-cols-3 lg:gap-8">
          {
            tripleEngine.items.map((item, i) => (
              <article
                class="card-elevated group relative overflow-hidden rounded-2xl border border-cream-dim/10 bg-surface p-8 hover:border-sand/40"
                data-reveal
                style={`--reveal-delay: ${i * 100}ms`}
              >
                <span class="pointer-events-none absolute -right-6 -top-8 text-[7rem] font-black leading-none text-cream/[0.04] transition-colors group-hover:text-sand/[0.07]" aria-hidden="true">
                  {i + 1}
                </span>
                <div class="mb-6 flex h-12 w-12 items-center justify-center rounded-xl border border-sand/30 bg-base text-xl font-black text-sand transition group-hover:scale-105 group-hover:border-sand/60">
                  {i + 1}
                </div>
                <h3 class="text-xl font-bold text-cream">{item.title}</h3>
                <p class="mt-3 leading-relaxed text-cream-dim/70">{item.body}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- 3-STEP PROCESS -->
    <section class="bg-surface px-6 py-24 lg:py-32">
      <div class="mx-auto max-w-5xl">
        <h2 class="text-center text-3xl font-black leading-tight text-cream md:text-5xl" data-reveal>
          {process.headingStart}
          <span class="rounded-lg bg-forest/20 px-2 py-0.5 text-sand">{process.headingHighlight}</span>
          {process.headingMiddle}
          <span class="text-sand">{process.headingAccent}</span>
        </h2>

        <div class="relative mt-16 grid gap-10 md:grid-cols-3 md:gap-8">
          <!-- Connecting line (desktop) -->
          <div class="pointer-events-none absolute left-[16%] right-[16%] top-0 hidden h-px bg-gradient-to-r from-forest/60 via-sand/40 to-forest/60 md:block" aria-hidden="true"></div>
          {
            process.steps.map((step, i) => (
              <div
                class="card-elevated relative rounded-2xl border border-cream-dim/10 bg-base p-8 pt-10 hover:border-forest/50"
                data-reveal
                style={`--reveal-delay: ${i * 120}ms`}
              >
                <span class="absolute -top-4 left-6 rounded-full bg-forest px-4 py-1.5 text-xs font-bold uppercase tracking-wide text-cream shadow-[0_8px_16px_-6px_var(--color-forest)]">
                  {step.tag}
                </span>
                <h3 class="text-xl font-bold text-cream">{step.title}</h3>
                <p class="mt-3 leading-relaxed text-cream-dim/70">{step.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="px-6 py-24 lg:py-32">
      <div class="mx-auto max-w-3xl">
        <h2 class="text-center text-3xl font-black leading-tight text-cream md:text-4xl" data-reveal>
          {faq.heading}
        </h2>

        <div class="mt-12 space-y-4">
          {
            faq.items.map((item, i) => (
              <details
                class="group rounded-2xl border border-cream-dim/10 bg-surface transition-colors open:border-sand/40 open:shadow-[0_16px_32px_-12px_rgb(0_0_0_/_0.5)] hover:border-cream-dim/25"
                data-reveal
                style={`--reveal-delay: ${i * 80}ms`}
              >
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-6 font-bold text-cream transition hover:text-sand">
                  <span>{item.question}</span>
                  <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-sand/30 bg-base text-sand transition-transform duration-300 group-open:rotate-180">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                    </svg>
                  </span>
                </summary>
                <p class="px-6 pb-6 leading-relaxed text-cream-dim/80">{item.answer}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- FINAL CTA -->
    <section class="px-6 pb-28 pt-4">
      <div
        class="relative mx-auto max-w-4xl overflow-hidden rounded-[2.5rem] border border-sand/20 bg-gradient-to-br from-surface via-surface to-forest/10 p-8 text-center shadow-[0_32px_80px_-24px_rgb(0_0_0_/_0.7)] md:p-16"
        data-reveal
      >
        <div class="bg-dot-grid pointer-events-none absolute inset-0 opacity-50" aria-hidden="true"></div>
        <div class="relative">
          <h2 class="text-3xl font-black leading-tight text-cream md:text-5xl">
            {finalCta.heading}
          </h2>
          <p class="mx-auto mt-5 max-w-2xl text-lg text-cream-dim/80">
            {finalCta.body}
          </p>
          <p class="mx-auto mt-6 max-w-xl rounded-2xl border border-cream-dim/10 bg-base/80 p-4 text-cream-dim backdrop-blur-sm">
            {finalCta.note}
          </p>
          <div class="mt-10">
            <FreeMockupModal triggerLabel={finalCta.cta} />
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
