---
import Layout from '../layouts/Layout.astro';
import FreeMockupModal from '../components/FreeMockupModal.astro';

const title = 'Contact | Ace Static Creatives';
const description =
  'Get in touch with Ace Static Creatives via WhatsApp. Fast, friendly support for static websites, ads, and copy in Guyana.';
---

<Layout title={title} description={description}>
  <main class="w-full overflow-hidden">
    <section class="px-6 pb-16 pt-28 text-center">
      <span class="inline-block rounded-full border border-sand/30 bg-surface-2 px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-sand">
        Contact
      </span>
      <h1 class="mx-auto mt-6 max-w-4xl text-4xl font-black leading-tight tracking-tight text-cream md:text-6xl">
        Put an expert team in <span class="text-sand">your contacts</span>
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-cream-dim/80 md:text-xl">
        No tickets, no waiting rooms, no tech jargon. Just WhatsApp us and we'll handle the rest.
      </p>
    </section>

    <section class="px-6 py-20">
      <div class="mx-auto max-w-5xl">
        <div class="grid gap-8 md:grid-cols-2">
          <div class="rounded-2xl border border-cream-dim/10 bg-gradient-to-br from-surface to-base p-8 text-center md:p-12">
            <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-2xl border border-sand/30 bg-base text-sand">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="h-8 w-8"
              >
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
              </svg>
            </div>
            <h2 class="text-2xl font-black text-cream md:text-3xl">WhatsApp us</h2>
            <p class="mx-auto mt-3 max-w-sm text-cream-dim/70">
              The fastest way to get help, request updates, or claim your free mockup.
            </p>
            <div class="mt-8">
              <FreeMockupModal triggerLabel="Claim Your FREE 24/7 Digital Salesman Mockup" />
            </div>
          </div>

          <div class="rounded-2xl border border-cream-dim/10 bg-surface p-8 md:p-12">
            <h2 class="text-2xl font-black text-cream md:text-3xl">Other ways to reach us</h2>
            <ul class="mt-6 space-y-6">
              <li class="flex items-start gap-4">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-sand/30 bg-base text-sand">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    class="h-5 w-5"
                  >
                    <path d="M1.5 8.67v8.58a3 3 0 003 3h15a3 3 0 003-3V8.67l-8.928 5.493a3 3 0 01-3.144 0L1.5 8.67z" />
                    <path d="M22.5 6.908V6.75a3 3 0 00-3-3h-15a3 3 0 00-3 3v.158l9.714 5.978a1.5 1.5 0 001.572 0L22.5 6.908z" />
                  </svg>
                </div>
                <div>
                  <h3 class="font-bold text-cream">Email</h3>
                  <a
                    href="mailto:hello@acestaticcreatives.com"
                    class="text-cream-dim/70 transition hover:text-sand"
                    >hello@acestaticcreatives.com</a
                  >
                </div>
              </li>
              <li class="flex items-start gap-4">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-sand/30 bg-base text-sand">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    class="h-5 w-5"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M11.54 22.351l.07.04-.028-.006a8.25 8.25 0 01-.436-.127 36.5 36.5 0 01-2.786-1.05C5.593 19.68 3.5 17.19 3.5 14V7.25a.75.75 0 01.75-.75h.38c2.865 0 5.567-1.255 7.44-3.43l.182-.213a.75.75 0 011.136 0l.182.213c1.873 2.175 4.575 3.43 7.44 3.43h.38a.75.75 0 01.75.75V14c0 3.19-2.093 5.68-4.984 7.118a36.5 36.5 0 01-2.786 1.05 8.25 8.25 0 01-.436.127l.07-.04zM12 12.75a3.75 3.75 0 100-7.5 3.75 3.75 0 000 7.5z"
                      clip-rule="evenodd"
                    />
                  </svg>
                </div>
                <div>
                  <h3 class="font-bold text-cream">Location</h3>
                  <p class="text-cream-dim/70">Georgetown, Guyana</p>
                </div>
              </li>
              <li class="flex items-start gap-4">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-sand/30 bg-base text-sand">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    class="h-5 w-5"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25zM12.75 6a.75.75 0 00-1.5 0v6c0 .414.336.75.75.75h4.5a.75.75 0 000-1.5h-3.75V6z"
                      clip-rule="evenodd"
                    />
                  </svg>
                </div>
                <div>
                  <h3 class="font-bold text-cream">Response time</h3>
                  <p class="text-cream-dim/70">Usually within a few hours on WhatsApp.</p>
                </div>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="px-6 py-24 text-center">
      <div class="mx-auto max-w-4xl rounded-[2rem] border border-cream-dim/10 bg-gradient-to-br from-surface to-base p-8 md:p-16">
        <h2 class="text-3xl font-black leading-tight text-cream md:text-5xl">Let us prove it first</h2>
        <p class="mx-auto mt-6 max-w-2xl text-lg text-cream-dim/80">
          We'll build a custom, mobile-optimized homepage mockup for your business this week before
          you pay us a single dollar.
        </p>
        <div class="mt-10">
          <FreeMockupModal triggerLabel="Claim Your FREE 24/7 Digital Salesman Mockup" />
        </div>
      </div>
    </section>
  </main>
</Layout>
