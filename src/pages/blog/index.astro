---
import Layout from '../../layouts/Layout.astro';
import WhatsAppCta from '../../components/WhatsAppCta.astro';
import { seo } from '../../config/site';
import { blogPosts } from '../../data/blog';
---

<Layout title={seo.blog.title} description={seo.blog.description}>
  <main class="w-full overflow-hidden">
    <section class="relative px-6 pb-16 pt-24 text-center lg:pt-32">
      <div class="relative" data-reveal>
        <span class="inline-block rounded-full border border-gold/30 bg-cream/10 px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-gold">
          Blog
        </span>
        <h1 class="mx-auto mt-6 max-w-4xl text-balance text-4xl font-bold leading-tight tracking-tight text-cream md:text-6xl">
          Local SEO & website guides for businesses <span class="text-gold">in Georgetown, Guyana</span>
        </h1>
        <p class="mx-auto mt-6 max-w-2xl text-lg text-cream/80 md:text-xl">
          Short, plain-English articles that solve real local problems. No jargon, no fluff — just what works for Guyanese small businesses.
        </p>
      </div>
    </section>

    <section class="px-6 pb-24">
      <div class="mx-auto grid max-w-5xl gap-8 md:grid-cols-2">
        {
          blogPosts.map((post, i) => (
            <a
              href={`/blog/${post.slug}`}
              class="card-elevated group flex flex-col overflow-hidden rounded-2xl border border-cream/10 bg-surface hover:border-gold/40"
              data-reveal
              style={`--reveal-delay: ${i * 100}ms`}
            >
              <img
                src={post.image.src}
                srcset={post.image.srcset}
                sizes="(min-width: 768px) 448px, 100vw"
                alt=""
                aria-hidden="true"
                class="aspect-video w-full border-b border-cream/10 object-cover"
                width={post.image.width}
                height={post.image.height}
                loading="lazy"
                decoding="async"
              />
              <div class="flex flex-1 flex-col p-8">
              <p class="text-xs font-bold uppercase tracking-wider text-gold">
                {new Date(post.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
              </p>
              <h2 class="mt-4 text-xl font-bold leading-snug text-cream transition group-hover:text-gold md:text-2xl">
                {post.title}
              </h2>
              <p class="mt-4 flex-1 leading-relaxed text-cream/70">{post.description}</p>
              <p class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-gold">
                Read the article
                <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </p>
              </div>
            </a>
          ))
        }
      </div>

      <div class="mx-auto mt-16 max-w-3xl text-center" data-reveal>
        <p class="text-lg text-cream/80">
          Want guides like these written for your business every week? That's exactly what the Local Authority plan includes.
        </p>
        <div class="mt-8">
          <WhatsAppCta label="Claim Your Digital Salesman" message="Hi Ace Static Creatives! I read your blog and want to claim my Digital Salesman for my business." />
        </div>
      </div>
    </section>
  </main>
</Layout>
