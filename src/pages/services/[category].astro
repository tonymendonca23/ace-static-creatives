---
import Layout from '../../layouts/Layout.astro';
import FreeMockupModal from '../../components/FreeMockupModal.astro';
import { serviceCategories, getCategory } from '../../data/services';
import { contact, brand } from '../../config/site';

export function getStaticPaths() {
  return serviceCategories.map((cat) => ({ params: { category: cat.id } }));
}

const { category } = Astro.params;
const cat = getCategory(category!);

if (!cat) {
  return Astro.redirect('/services');
}

const title = `${cat.keyword} | Ace Static Creatives`;
const description = cat.metaDescription;

/* JSON-LD: Service with provider (address), areaServed (containedInPlace), offers */
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: cat.keyword,
  description: cat.subheadline,
  serviceType: cat.eyebrow,
  provider: {
    '@type': 'LocalBusiness',
    '@id': 'https://ace-static-creatives.com/#business',
    name: brand.name,
    telephone: `+${contact.whatsappNumber}`,
    email: contact.email,
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Georgetown',
      addressRegion: 'Demerara-Mahaica',
      addressCountry: 'GY',
    },
  },
  areaServed: {
    '@type': 'City',
    name: 'Georgetown',
    containedInPlace: { '@type': 'Country', name: 'Guyana' },
  },
  offers: [
    {
      '@type': 'Offer',
      priceCurrency: 'GYD',
      price: '20000',
      description: 'The Digital Salesman — $0 setup, $20,000 GYD/mo (12-month agreement)',
      url: 'https://ace-static-creatives.com/services/',
    },
    {
      '@type': 'Offer',
      priceCurrency: 'GYD',
      price: '50000',
      description: 'The Local Authority — $20,000 GYD setup, $50,000 GYD/mo',
      url: 'https://ace-static-creatives.com/services/',
    },
  ],
};
---

<Layout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)}></script>

  <main class="w-full overflow-hidden">
    <!-- HERO: local-keyword H1 + eyebrow with local area -->
    <section class="relative px-6 pb-16 pt-14 lg:pb-20 lg:pt-20">
      <div class="bg-glow-forest pointer-events-none absolute inset-0" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-4xl text-center" data-reveal>
        <p class="inline-block rounded-full border border-sand/30 bg-surface-2 px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-sand">
          {cat.eyebrow} — Georgetown, Guyana
        </p>
        <h1 class="mt-6 text-balance text-4xl font-black leading-[1.1] tracking-tight text-cream md:text-5xl lg:text-6xl">
          {cat.headline}
        </h1>
        <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-cream-dim/80 md:text-xl">
          {cat.subheadline}
        </p>
        <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <FreeMockupModal triggerLabel="Get My Free Mockup & GYD Quote" />
          <a
            href={contact.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-full border border-cream-dim/30 px-6 py-3.5 text-sm font-bold text-cream transition hover:border-sand hover:text-sand"
          >
            WhatsApp {contact.whatsappNumber}
          </a>
        </div>
        <p class="mt-5 text-sm text-cream-dim/60">No hidden fees. No surprise bills. Ever.</p>
      </div>
    </section>

    <!-- WHAT YOU GET + PRICING -->
    <section class="bg-surface px-6 py-20 lg:py-24">
      <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-5">
        <div class="lg:col-span-3" data-reveal>
          <h2 class="text-2xl font-black leading-tight text-cream md:text-3xl">
            What you get with {cat.eyebrow.toLowerCase()} in Georgetown
          </h2>
          <ul class="mt-6 space-y-4">
            {
              cat.bullets.map((b) => (
                <li class="flex items-start gap-3 leading-relaxed text-cream-dim">
                  <svg class="mt-1 h-5 w-5 shrink-0 text-sand" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                  {b}
                </li>
              ))
            }
          </ul>
          <p class="mt-6 rounded-2xl border border-cream-dim/10 bg-base p-5 text-sm leading-relaxed text-cream-dim/80">
            {cat.trustLine}
          </p>
        </div>

        <aside class="lg:col-span-2" data-reveal style="--reveal-delay: 120ms">
          <div class="card-elevated rounded-3xl border border-forest/50 bg-base p-8 shadow-[0_0_60px_-20px_var(--color-forest)]">
            <p class="text-xs font-bold uppercase tracking-wider text-sand">Pricing in GYD</p>
            <p class="mt-3 text-3xl font-black text-cream">{cat.priceLabel}</p>
            <p class="mt-2 text-sm text-cream-dim/70">{cat.priceNote}</p>
            <div class="mt-6">
              <FreeMockupModal triggerLabel="Claim Your FREE Mockup" triggerClass="w-full" />
            </div>
            <p class="mt-4 text-xs text-cream-dim/60">
              90-day Google visibility guarantee: not on Google for your core services? We work free until you are.
            </p>
          </div>
        </aside>
      </div>
    </section>

    <!-- FAQ -->
    <section class="px-6 py-20 lg:py-24">
      <div class="mx-auto max-w-3xl">
        <h2 class="text-center text-2xl font-black leading-tight text-cream md:text-4xl" data-reveal>
          Questions about {cat.eyebrow.toLowerCase()} in Georgetown, Guyana
        </h2>
        <div class="mt-10 space-y-4">
          {
            cat.faq.map((item, i) => (
              <details
                class="group rounded-2xl border border-cream-dim/10 bg-surface transition-colors open:border-sand/40 hover:border-cream-dim/25"
                data-reveal
                style={`--reveal-delay: ${i * 80}ms`}
              >
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-6 font-bold text-cream transition hover:text-sand">
                  <span>{item.question}</span>
                  <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-sand/30 bg-base text-sand transition-transform duration-300 group-open:rotate-180">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                    </svg>
                  </span>
                </summary>
                <p class="px-6 pb-6 leading-relaxed text-cream-dim/80">{item.answer}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- BOTTOM CTA + BACK LINK -->
    <section class="px-6 pb-24">
      <div class="mx-auto max-w-3xl text-center" data-reveal>
        <FreeMockupModal triggerLabel="Get Started — Free Mockup First" />
        <p class="mt-8">
          <a href="/services" class="text-sm font-semibold text-sand underline-offset-4 hover:underline">
            ← Back to all services
          </a>
        </p>
      </div>
    </section>
  </main>
</Layout>
