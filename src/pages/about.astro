---
import Layout from '../layouts/Layout.astro';
import FreeMockupModal from '../components/FreeMockupModal.astro';
import { seo, about } from '../config/site';

const { hero, whyFail, pillars, mission, finalCta } = about;
---

<Layout title={seo.about.title} description={seo.about.description}>
  <main class="w-full overflow-hidden">
    <!-- HERO -->
    <section class="relative px-6 pb-20 pt-24 text-center lg:pt-32">
      <div class="bg-glow-forest pointer-events-none absolute inset-0" aria-hidden="true"></div>
      <div class="relative" data-reveal>
        <p class="inline-block rounded-full border border-sand/30 bg-surface-2 px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-sand">
          {hero.eyebrow}
        </p>
        <h1 class="mx-auto mt-6 max-w-5xl text-balance text-4xl font-black leading-[1.08] tracking-tight text-cream md:text-5xl lg:text-6xl">
          {hero.headline}
        </h1>
        <p class="mx-auto mt-6 max-w-3xl text-lg leading-relaxed text-cream-dim/80 md:text-xl">
          {hero.subheadlineStart}
          <span class="font-semibold text-cream"> {hero.subheadlineEmphasis}</span>
        </p>
      </div>
    </section>

    <!-- VILLAIN: WHY MOST WEBSITES FAIL -->
    <section class="relative bg-surface px-6 py-24 lg:py-32">
      <div class="bg-dot-grid pointer-events-none absolute inset-0 opacity-40" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-6xl">
        <div class="mb-16 text-center" data-reveal>
          <h2 class="text-3xl font-black leading-tight text-cream md:text-5xl">
            {whyFail.heading}
          </h2>
        </div>

        <div class="mx-auto max-w-4xl space-y-6 text-lg leading-relaxed text-cream-dim/80" data-reveal>
          {
            whyFail.paragraphs.map((p) => (
              <p>
                {p.before}
                {p.emphasis && <span class="font-bold text-cream"> {p.emphasis}</span>}
              </p>
            ))
          }
        </div>

        <div class="mx-auto mt-14 grid max-w-4xl gap-4 rounded-3xl border border-cream-dim/10 bg-base p-6 shadow-[0_24px_48px_-16px_rgb(0_0_0_/_0.5)] md:grid-cols-2 md:p-8" data-reveal>
          <div class="rounded-2xl border border-clay/20 bg-surface p-6">
            <h3 class="mb-2 text-sm font-bold uppercase tracking-wider text-clay">
              {whyFail.traditionalLabel}
            </h3>
            <p class="text-cream-dim/80">{whyFail.traditionalBody}</p>
          </div>
          <div class="rounded-2xl border border-forest/30 bg-forest/10 p-6">
            <h3 class="mb-2 text-sm font-bold uppercase tracking-wider text-sand">
              {whyFail.aceLabel}
            </h3>
            <p class="text-cream">{whyFail.aceBody}</p>
          </div>
        </div>

        <div class="mx-auto mt-14 max-w-4xl" data-reveal>
          <p class="text-center text-lg leading-relaxed text-cream-dim">
            {whyFail.realizationStart}
            <span class="font-bold text-cream"> {whyFail.realizationEmphasis} </span>
            {whyFail.realizationEnd}
          </p>
        </div>
      </div>
    </section>

    <!-- CORE PILLARS -->
    <section class="relative px-6 py-24 lg:py-32">
      <div class="bg-glow-sand pointer-events-none absolute inset-0" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-6xl">
        <div class="mb-16 text-center" data-reveal>
          <h2 class="text-3xl font-black leading-tight text-cream md:text-5xl">
            {pillars.heading}
          </h2>
          <p class="mx-auto mt-4 max-w-2xl text-lg text-cream-dim/80">
            {pillars.subheading}
          </p>
        </div>

        <div class="grid gap-6 md:grid-cols-2">
          {
            pillars.items.map((pillar, i) => (
              <div
                class="card-elevated group relative overflow-hidden rounded-2xl border border-cream-dim/10 bg-surface p-8 hover:border-sand/40"
                data-reveal
                style={`--reveal-delay: ${i * 90}ms`}
              >
                <span class="pointer-events-none absolute -right-4 -top-6 text-[6rem] font-black leading-none text-cream/[0.04] transition-colors group-hover:text-sand/[0.07]" aria-hidden="true">
                  {pillar.number}
                </span>
                <div class="mb-5 flex h-11 w-11 items-center justify-center rounded-xl bg-forest text-sm font-black text-cream shadow-[0_8px_20px_-8px_var(--color-forest)] transition-transform group-hover:scale-105">
                  {pillar.number}
                </div>
                <h3 class="text-xl font-bold text-cream">{pillar.title}</h3>
                <p class="mt-3 leading-relaxed text-cream-dim/70">{pillar.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- MISSION STATEMENT -->
    <section class="bg-surface px-6 py-24 text-center lg:py-32">
      <div class="mx-auto max-w-4xl" data-reveal>
        <h2 class="text-3xl font-black leading-tight text-cream md:text-5xl">
          {mission.heading}
        </h2>
        {
          mission.paragraphs.map((p) => (
            <p class="mx-auto mt-6 max-w-3xl text-lg leading-relaxed text-cream-dim/80">
              {p.before}
              {p.emphasis && <span class="font-semibold text-cream"> {p.emphasis}</span>}
            </p>
          ))
        }
      </div>
    </section>

    <!-- FINAL CTA -->
    <section class="px-6 py-24 text-center lg:py-28">
      <div
        class="relative mx-auto max-w-4xl overflow-hidden rounded-[2.5rem] border border-cream-dim/10 bg-gradient-to-br from-surface via-surface to-forest/10 p-8 shadow-[0_32px_80px_-24px_rgb(0_0_0_/_0.7)] md:p-16"
        data-reveal
      >
        <div class="bg-dot-grid pointer-events-none absolute inset-0 opacity-50" aria-hidden="true"></div>
        <div class="relative">
          <h2 class="text-3xl font-black leading-tight text-cream md:text-5xl">
            {finalCta.heading}
          </h2>
          <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-cream-dim/80">
            {finalCta.body}
          </p>
          <div class="mt-10">
            <FreeMockupModal triggerLabel={finalCta.cta} />
          </div>
          <div class="mx-auto mt-12 max-w-xl rounded-2xl border border-cream-dim/10 bg-base/70 p-6 text-left backdrop-blur-sm">
            <p class="mb-4 font-bold text-cream">{finalCta.nextHeading}</p>
            <ol class="space-y-3 text-cream-dim/80">
              {
                finalCta.nextSteps.map((step, i) => (
                  <li class="flex items-start gap-3">
                    <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-sand/40 bg-surface text-xs font-black text-sand">
                      {i + 1}
                    </span>
                    <span class="pt-0.5">{step}</span>
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
