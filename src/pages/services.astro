---
import Layout from '../layouts/Layout.astro';
import FreeMockupModal from '../components/FreeMockupModal.astro';
import { seo, services } from '../config/site';

const { hero, pain, comparison, packages, guarantee, finalCta } = services;
---

<Layout title={seo.services.title} description={seo.services.description}>
  <main class="w-full overflow-hidden">
    <!-- HERO -->
    <section class="relative px-6 pb-20 pt-14 text-center lg:pb-24 lg:pt-20">
      <div class="bg-glow-forest pointer-events-none absolute inset-0" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-5xl" data-reveal>
        <p class="mx-auto max-w-3xl rounded-full border border-clay/30 bg-clay/10 px-5 py-2 text-xs font-bold uppercase tracking-wider text-sand sm:text-sm">
          {hero.eyebrow}
        </p>
        <h1
          class="mx-auto mt-8 text-balance text-4xl font-black leading-[1.08] tracking-tight text-cream md:text-5xl lg:text-6xl"
        >
          {hero.headline}
        </h1>
        <p class="mx-auto mt-6 max-w-3xl text-lg leading-relaxed text-cream-dim/80 md:text-xl">
          {hero.subheadline}
        </p>
        <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <FreeMockupModal
            triggerLabel={hero.cta}
            triggerClass="max-w-xl px-6 py-4 text-sm sm:text-base"
          />
        </div>
        <p class="mt-4 text-sm text-cream-dim/60">
          {hero.reassurance}
        </p>
      </div>
    </section>

    <!-- PAIN SECTION -->
    <section class="relative bg-surface px-6 py-24 lg:py-32">
      <div class="bg-dot-grid pointer-events-none absolute inset-0 opacity-40" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-6xl">
        <div class="mb-16 text-center" data-reveal>
          <h2 class="text-3xl font-black leading-tight text-cream md:text-5xl">
            {pain.heading}
          </h2>
          <p class="mx-auto mt-6 max-w-3xl text-lg leading-relaxed text-cream-dim/80">
            {pain.subheading}
          </p>
        </div>

        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {
            pain.cards.map((card, i) => (
              <div
                class="card-elevated rounded-2xl border border-cream-dim/10 bg-base p-6 hover:border-clay/40"
                data-reveal
                style={`--reveal-delay: ${i * 80}ms`}
              >
                <span class="mb-4 flex h-10 w-10 items-center justify-center rounded-lg bg-clay/15 text-lg text-clay" aria-hidden="true">
                  ✕
                </span>
                <h3 class="mb-3 text-lg font-bold text-cream">{card.title}</h3>
                <p class="text-sm leading-relaxed text-cream-dim/70">{card.body}</p>
              </div>
            ))
          }
        </div>

        <div class="mx-auto mt-14 max-w-4xl rounded-2xl border-l-4 border-clay bg-base p-8 shadow-[0_16px_40px_-16px_rgb(0_0_0_/_0.6)]" data-reveal>
          <p class="text-lg leading-relaxed text-cream-dim">
            <span class="font-bold text-clay">{pain.truthLabel}</span>
            {pain.truthBody}
          </p>
        </div>
      </div>
    </section>

    <!-- FEATURES VS BENEFITS -->
    <section class="px-6 py-24 lg:py-32">
      <div class="mx-auto max-w-6xl">
        <div class="mb-16 text-center" data-reveal>
          <h2 class="text-3xl font-black leading-tight text-cream md:text-5xl">
            {comparison.heading}
          </h2>
        </div>

        <div class="overflow-hidden rounded-3xl border border-cream-dim/10 shadow-[0_24px_60px_-20px_rgb(0_0_0_/_0.7)]" data-reveal>
          <div class="grid md:grid-cols-2">
            <div class="bg-surface p-8 md:p-10">
              <h3 class="mb-6 text-xl font-bold text-cream-dim/70">
                {comparison.standardHeading}
              </h3>
              <ul class="space-y-4">
                {comparison.rows.map((row) => (
                  <li class="flex items-start gap-3 text-cream-dim/80">
                    <span class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-clay/15 text-xs text-clay">✕</span>
                    <span>{row.standard}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div class="relative bg-forest/10 p-8 md:p-10">
              <div class="pointer-events-none absolute inset-y-0 left-0 hidden w-px bg-gradient-to-b from-transparent via-sand/30 to-transparent md:block" aria-hidden="true"></div>
              <h3 class="mb-6 text-xl font-bold text-sand">{comparison.aceHeading}</h3>
              <ul class="space-y-4">
                {comparison.rows.map((row) => (
                  <li class="flex items-start gap-3 text-cream">
                    <span class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-forest/25 text-xs text-sand">✓</span>
                    <span>{row.ace}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- PACKAGES -->
    <section class="relative bg-surface px-6 py-24 lg:py-32">
      <div class="bg-glow-sand pointer-events-none absolute inset-0" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-7xl">
        <div class="mb-16 text-center" data-reveal>
          <h2 class="text-3xl font-black leading-tight text-cream md:text-5xl">
            {packages.heading}
          </h2>
          <p class="mx-auto mt-4 max-w-2xl text-lg text-cream-dim/80">
            {packages.subheading}
          </p>
        </div>

        <div class="grid gap-8 lg:grid-cols-3 lg:items-stretch">
          {
            packages.items.map((pkg, i) => (
              <div
                class:list={[
                  'card-elevated relative flex flex-col rounded-3xl border p-8 pt-10',
                  pkg.featured
                    ? 'border-forest/60 bg-gradient-to-b from-forest/15 to-base shadow-[0_0_60px_-20px_var(--color-forest)] lg:-my-4 lg:py-12'
                    : 'border-cream-dim/10 bg-base',
                ]}
                data-reveal
                style={`--reveal-delay: ${i * 100}ms`}
              >
                <span
                  class:list={[
                    'absolute -top-3.5 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-full px-4 py-1.5 text-xs font-bold uppercase tracking-wider',
                    pkg.featured
                      ? 'bg-forest text-cream shadow-[0_8px_20px_-6px_var(--color-forest)]'
                      : 'bg-surface-2 text-cream-dim',
                  ]}
                >
                  {pkg.tag}
                </span>

                <h3 class="text-2xl font-black text-cream">{pkg.name}</h3>

                <div class="mt-5 space-y-1.5 border-b border-cream-dim/10 pb-6">
                  <p class="text-sm text-cream-dim/70">{pkg.priceSetup}</p>
                  <p class="text-3xl font-black text-sand md:text-4xl">{pkg.priceMonthly}</p>
                  <p class="text-xs text-cream-dim/60">{pkg.renewal}</p>
                </div>

                <ul class="mt-6 flex-1 space-y-3.5">
                  {pkg.features.map((feature) => (
                    <li class="flex items-start gap-3 text-sm leading-relaxed text-cream-dim">
                      <svg
                        class="mt-0.5 h-5 w-5 shrink-0 text-sand"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                      >
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                      </svg>
                      {feature}
                    </li>
                  ))}
                </ul>

                <p class="mt-4 text-xs italic text-cream-dim/50">{pkg.note}</p>

                <div class="mt-8">
                  <FreeMockupModal triggerLabel={pkg.cta} triggerClass="w-full" />
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- GUARANTEE -->
    <section class="px-6 py-24 text-center lg:py-32">
      <div class="mx-auto max-w-3xl" data-reveal>
        <div class="mb-8 inline-flex h-20 w-20 items-center justify-center rounded-3xl border border-forest/40 bg-forest/15 text-4xl shadow-[0_0_40px_-12px_var(--color-forest)]">
          🛡️
        </div>
        <h2 class="text-3xl font-black leading-tight text-cream md:text-5xl">
          {guarantee.heading}
        </h2>
        <p class="mx-auto mt-6 text-lg leading-relaxed text-cream-dim/80">
          {guarantee.body}
        </p>
      </div>
    </section>

    <!-- FINAL CTA -->
    <section class="px-6 pb-28">
      <div
        class="relative mx-auto max-w-4xl overflow-hidden rounded-[2.5rem] border border-sand/30 bg-gradient-to-br from-surface via-surface to-forest/10 px-8 py-16 text-center shadow-[0_32px_80px_-24px_rgb(0_0_0_/_0.7)] md:px-16"
        data-reveal
      >
        <div class="bg-dot-grid pointer-events-none absolute inset-0 opacity-50" aria-hidden="true"></div>
        <div class="relative">
          <h2 class="text-3xl font-black leading-tight text-cream md:text-5xl">
            {finalCta.heading}
          </h2>
          <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-cream-dim/80">
            {finalCta.body}
          </p>
          <div class="mt-10">
            <FreeMockupModal triggerLabel={finalCta.cta} />
          </div>
          <ol class="mx-auto mt-12 max-w-xl space-y-4 text-left text-cream-dim/80">
            {
              finalCta.steps.map((step, i) => (
                <li class="flex items-start gap-4">
                  <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-sand/40 bg-base text-sm font-black text-sand">
                    {i + 1}
                  </span>
                  <span class="pt-1">{step}</span>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </section>
  </main>
</Layout>
