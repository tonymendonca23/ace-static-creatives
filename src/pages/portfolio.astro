---
import Layout from '../layouts/Layout.astro';
import FreeMockupModal from '../components/FreeMockupModal.astro';

const title = 'Portfolio | Ace Static Creatives';
const description =
  'See how Ace Static Creatives builds fast static DIGITAL SALESMAN, scroll-stopping ads, and persuasive copy for local Guyanese businesses.';

const projects = [
  {
    title: 'Bakery Bliss GT',
    category: 'Static Storefront',
    description:
      'A single-page storefront with a mouth-watering menu gallery, WhatsApp order button, and instant load speeds on mobile data.',
  },
  {
    title: 'Taxi Georgetown',
    category: 'Landing Page + Ads',
    description:
      '24/7 booking landing page paired with bold ad creatives that drive ride requests straight to WhatsApp.',
  },
  {
    title: 'Glow Salon',
    category: 'Brand Package',
    description:
      'Full static site, service menu, and persuasive Instagram ad copy designed to fill appointment slots.',
  },
  {
    title: 'Fresh Market Vendor',
    category: 'Static Storefront',
    description:
      'Lightweight product catalog and price list optimized for slow networks and quick customer decisions.',
  },
  {
    title: 'Auto Parts Guru',
    category: 'Ads + Copy',
    description:
      'Scroll-stopping ad creatives and direct-response copy that turned parts inquiries into daily sales.',
  },
  {
    title: 'Event Catering Co.',
    category: 'Full Growth Engine',
    description:
      'Multi-page site, ad design, and persuasive copy working together to capture catering leads year-round.',
  },
];
---

<Layout title={title} description={description}>
  <main class="w-full overflow-hidden">
    <section class="px-6 pb-16 pt-28 text-center">
      <span class="inline-block rounded-full border border-sand/30 bg-surface-2 px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-sand">
        Portfolio
      </span>
      <h1 class="mx-auto mt-6 max-w-4xl text-4xl font-black leading-tight tracking-tight text-cream md:text-6xl">
        Work that <span class="text-sand">speaks for itself</span>
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-cream-dim/80 md:text-xl">
        Fast DIGITAL SALESMAN, bold ads, and persuasive copy built for real Guyanese small businesses.
      </p>
    </section>

    <section class="px-6 py-20">
      <div class="mx-auto max-w-6xl">
        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
          {
            projects.map((project) => (
              <article class="group overflow-hidden rounded-2xl border border-cream-dim/10 bg-surface transition hover:border-sand/40">
                <div class="relative h-48 overflow-hidden bg-gradient-to-br from-sand/10 to-clay/10">
                  <div class="absolute inset-0 flex items-center justify-center opacity-40 transition group-hover:scale-105 group-hover:opacity-60">
                    <svg
                      class="h-16 w-16 text-sand"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1"
                      viewBox="0 0 24 24"
                    >
                      <rect width="18" height="18" x="3" y="3" rx="4" />
                      <path d="M3 15l6-6 4 4 8-8" />
                    </svg>
                  </div>
                  <span class="absolute left-4 top-4 rounded-full border border-cream-dim/20 bg-base/80 px-3 py-1 text-xs font-bold uppercase tracking-wider text-sand">
                    {project.category}
                  </span>
                </div>
                <div class="p-6">
                  <h3 class="text-xl font-bold text-cream">{project.title}</h3>
                  <p class="mt-3 leading-relaxed text-cream-dim/70">{project.description}</p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="px-6 py-24 text-center">
      <div class="mx-auto max-w-4xl rounded-[2rem] border border-cream-dim/10 bg-gradient-to-br from-surface to-base p-8 md:p-16">
        <h2 class="text-3xl font-black leading-tight text-cream md:text-5xl">
          Ready to be our next win?
        </h2>
        <p class="mx-auto mt-6 max-w-2xl text-lg text-cream-dim/80">
          Tell us about your business and we'll build a free mobile-optimized mockup this week.
        </p>
        <div class="mt-10">
          <FreeMockupModal triggerLabel="Claim Your FREE 24/7 Digital Salesman Mockup" />
        </div>
      </div>
    </section>
  </main>
</Layout>
