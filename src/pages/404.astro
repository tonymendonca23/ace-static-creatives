---
import Layout from '../layouts/Layout.astro';
import { siteUrl } from '../config/site';

const title = '404 - Page Not Found | Ace Static Creatives';
const description = 'The page you\'re looking for doesn\'t exist. Return to our homepage to explore web design services in Guyana.';
---

<Layout title={title} description={description}>
  <main class="flex min-h-[80vh] items-center justify-center px-6 py-20">
    <div class="mx-auto max-w-2xl text-center">
      <h1 class="text-6xl font-black text-cream md:text-8xl">404</h1>
      <p class="mt-6 text-2xl font-bold text-cream md:text-3xl">Page Not Found</p>
      <p class="mt-4 text-lg text-cream-dim">
        The page you're looking for doesn't exist or has been moved.
      </p>
      <div class="mt-8">
        <a
          href="/"
          class="inline-block rounded-lg bg-forest px-8 py-4 font-bold text-cream transition hover:bg-forest/90"
        >
          Return to Homepage
        </a>
      </div>
      <div class="mt-12 text-sm text-cream-dim">
        <p>Looking for our services?</p>
        <div class="mt-4 flex flex-wrap justify-center gap-4">
          <a href="/services" class="text-sand hover:underline">Web Design</a>
          <a href="/services" class="text-sand hover:underline">Digital Marketing</a>
          <a href="/portfolio" class="text-sand hover:underline">Portfolio</a>
          <a href="/contact" class="text-sand hover:underline">Contact</a>
        </div>
      </div>
    </div>
  </main>
</Layout>
