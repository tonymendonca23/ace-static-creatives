---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { colors, seo, siteUrl, brand, contact } from '../config/site';

interface Props {
  title?: string;
  description?: string;
}

const { title = seo.default.title, description = seo.default.description } = Astro.props;

// Build canonical URL from current path
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;

// Open Graph image (using hero image as fallback)
const ogImage = `${siteUrl}/hero-image-4.png`;

// JSON-LD structured data for LocalBusiness
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: brand.name,
  description: description,
  url: siteUrl,
  telephone: contact.whatsappNumber,
  email: contact.email,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Georgetown',
    addressCountry: 'GY',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: '6.8046',
    longitude: '-58.1551',
  },
  areaServed: {
    '@type': 'Country',
    name: 'Guyana',
  },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
    opens: '00:00',
    closes: '23:59',
  },
  priceRange: '$$',
  image: ogImage,
  sameAs: [
    // Add social media links here when available
  ],
};

/* Inject brand colors from the central config as CSS variables so the whole
   design system (global.css @theme) is driven by src/config/site.ts. */
const brandVars = `
  :root {
    --brand-base: ${colors.base};
    --brand-surface: ${colors.surface};
    --brand-surface-2: ${colors.surface2};
    --brand-cream: ${colors.cream};
    --brand-cream-dim: ${colors.creamDim};
    --brand-sand: ${colors.sand};
    --brand-olive: ${colors.olive};
    --brand-forest: ${colors.forest};
    --brand-clay: ${colors.clay};
    --brand-clay-dark: ${colors.clayDark};
    --brand-warm-blue: ${colors.warmBlue};
  }
`;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow" />
		<title>{title}</title>
		
		<!-- Canonical URL -->
		<link rel="canonical" href={canonicalUrl} />
		
		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:locale" content="en_US" />
		
		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalUrl} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		
		<!-- JSON-LD Structured Data -->
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
		
		<style set:html={brandVars}></style>
		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&family=Sora:wght@500;600;700;800&display=swap" rel="stylesheet">
	</head>
	<body class="bg-base text-cream font-sans antialiased selection:bg-clay selection:text-cream">
		<Header />
		<slot />
		<Footer />
		<script>
			// Scroll-reveal: adds .is-revealed when [data-reveal] elements enter view.
			if ('IntersectionObserver' in window) {
				const observer = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (entry.isIntersecting) {
								entry.target.classList.add('is-revealed');
								observer.unobserve(entry.target);
							}
						}
					},
					{ threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
				);
				document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));
			} else {
				document.documentElement.classList.add('no-observer');
			}
		</script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100vh;
	}
</style>
